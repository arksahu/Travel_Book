# ==========================================
# WanderWise Environment Configuration
# ==========================================

# Frontend Environment Variables (in frontend/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=WanderWise
VITE_ENABLE_DEMO_MODE=true

# Backend Environment Variables (in backend/.env)
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-vercel-domain.vercel.app"]

# Supabase Credentials (Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...your-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Generative AI Provider (gemini or openai)
AI_PROVIDER=gemini
# Provider API Key (kept securely on the backend only)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
